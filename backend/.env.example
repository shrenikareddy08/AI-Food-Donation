# ====================================================================
# MealBridge AI 2.0 — Environment Variables Configuration
# ====================================================================

# Relational Database (PostgreSQL 16 with pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=food_donation_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here

# Document Database (MongoDB for OTP ephemeral verification & activity logs)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=mealbridge_auth

# Authentication & Security
JWT_SECRET_KEY=mealbridge-super-secret-key-change-this-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_HASH_SECRET=mealbridge-otp-secret-hmac-key-2026

# Email Communication Service (SMTP)
# If left empty, system operates in mock/console mode for local development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MealBridge
FRONTEND_URL=http://localhost:5173

# Optional LLM API Key for Basic RAG Assistance (falls back to local grounded synthesis if unset)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Real SMS OTP Service (Fast2SMS, Twilio, MSG91, or Generic REST)
SMS_PROVIDER=generic
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_ID=MLBRDG
FAST2SMS_ROUTE=otp
FAST2SMS_TEMPLATE_ID=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

